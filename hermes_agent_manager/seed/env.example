# Frappe / ERPNext connection — set these in the Hermes process environment.
# Internal API base URL. The agent uses this; never show it to the user.
FRAPPE_URL=http://your-frappe-internal-host
# Public frontend URL. Always show this to the user.
FRAPPE_URL_USER=https://your-public-frappe-host
# API token credentials (Frappe -> User -> API Access).
FRAPPE_API_KEY=replace-me
FRAPPE_API_SECRET=replace-me
# Optional site name used by Frappe.
FM_SITE=your-site-name
