# Ham interactive bash defaults (sourced from /etc/bash.bashrc).

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=100000
HISTFILESIZE=200000
HISTTIMEFORMAT='%F %T '
shopt -s histappend
shopt -s cmdhist
shopt -s checkwinsize
shopt -s cdspell
shopt -s dirspell
shopt -s globstar 2>/dev/null

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export LANGUAGE=en_US.UTF-8
export EDITOR=vim

if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
  alias ls='ls --color=auto'
  alias grep='grep --color=auto'
fi

if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

alias ll='ls -alFh'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'
alias h='history'

if command -v git >/dev/null 2>&1; then
  alias gs='git status'
  alias gd='git diff'
  alias gl='git log --oneline --graph --decorate'
fi

# Like FM's fm_host(): show agent.localhost in the prompt.
ham_host() {
  if [ -n "$HAM_AGENT" ]; then
    printf '%s.localhost' "$HAM_AGENT"
    return
  fi
  hostname
}

ham_site() {
  if [ -n "$FM_SITE" ]; then
    printf '%s' "$FM_SITE"
    return
  fi
  if [ -f /opt/data/.env ]; then
    # shellcheck disable=SC1091
    FM_SITE=$(awk -F= '/^FM_SITE=/{print $2; exit}' /opt/data/.env)
    if [ -n "$FM_SITE" ]; then
      printf '%s' "$FM_SITE"
    fi
  fi
}

git_branch() {
  if ! command -v git >/dev/null 2>&1; then
    return
  fi
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || return
  if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
    printf ' (%s*)' "$branch"
  else
    printf ' (%s)' "$branch"
  fi
}

COLOR_RESET='\[\033[0m\]'
COLOR_USER='\[\033[01;32m\]'
COLOR_ROOT='\[\033[01;31m\]'
COLOR_HOST='\[\033[01;36m\]'
COLOR_DIR='\[\033[01;34m\]'
COLOR_GIT='\[\033[01;33m\]'
COLOR_PROMPT='\[\033[01;32m\]'

if [ "$EUID" -eq 0 ]; then
  PS1="${COLOR_ROOT}\u${COLOR_RESET}@${COLOR_HOST}\$(ham_host)${COLOR_RESET}:${COLOR_DIR}\w${COLOR_GIT}\$(git_branch)${COLOR_RESET}\n${COLOR_ROOT}# ${COLOR_RESET}"
else
  PS1="${COLOR_USER}\u${COLOR_RESET}@${COLOR_HOST}\$(ham_host)${COLOR_RESET}:${COLOR_DIR}\w${COLOR_GIT}\$(git_branch)${COLOR_RESET}\n${COLOR_PROMPT}\$${COLOR_RESET} "
fi

# curl maps *.localhost to 127.0.0.1 (RFC 6761). Force FM site host through the
# host reverse proxy (same path as the Mac browser).
curl() {
  local site ip
  site="${FM_SITE:-}"
  if [ -z "$site" ] && [ -f /opt/data/.env ]; then
    site=$(awk -F= '/^FM_SITE=/{print $2; exit}' /opt/data/.env)
  fi
  if [ -n "$site" ]; then
    ip=$(getent hosts host.docker.internal 2>/dev/null | awk '{print $1; exit}')
    if [ -n "$ip" ]; then
      command curl --resolve "${site}:80:${ip}" --resolve "${site}:443:${ip}" "$@"
      return
    fi
  fi
  command curl "$@"
}

if [[ $- == *i* ]] && [[ -z "$HAM_WELCOME_SHOWN" ]]; then
  export HAM_WELCOME_SHOWN=1
  echo ""
  echo "Welcome to Hermes Agent Manager"
  echo "Agent: $(ham_host)"
  site=$(ham_site)
  if [ -n "$site" ]; then
    echo "FM site: $site ($FRAPPE_URL)"
  fi
  echo ""
fi

if [ -f /opt/data/.bashrc ]; then
  . /opt/data/.bashrc
fi
